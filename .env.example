# Environment variable template — KEY NAMES ONLY, no values.
# Copy to `.env` and fill in per environment. Never commit `.env`.
# See docs/deployment-policy.md for secret handling and per-environment rules.

# --- Core / session ---
DISU_SESSION_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- Password policy ---
# Breached-password check on register and password reset (§2.3). Uses the Pwned
# Passwords k-anonymity range API: only the first five characters of the
# candidate's SHA-1 leave the process, and a failed lookup fails open. Defaults
# to on everywhere except NODE_ENV=test; set to off/false/0 only where the app
# cannot make outbound calls.
PASSWORD_BREACH_CHECK=

# --- Google sign-in ---
# Optional: the login page hides the Google button unless both the client id and
# secret are set. Create a "Web application" OAuth client in Google Cloud and
# register <origin>/api/auth/google/callback as an authorized redirect URI.
# GOOGLE_OAUTH_REDIRECT_URI only needs setting when the app cannot derive its own
# public origin from the request (e.g. behind a proxy that rewrites the host).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Python runtimes ---
QUANT_PYTHON_BIN=
PRIMER_PYTHON_BIN=

# --- Quant pipeline ---
# Production requires QUANT_MOCK_FALLBACK_MODE=never (see docs/deployment-policy.md).
QUANT_MOCK_FALLBACK_MODE=
QUANT_ALLOW_MOCK_FALLBACK=
QUANT_JOB_TIMEOUT_MS=
QUANT_MODEL_VERSION=

# --- Primer pipeline ---
# Production requires PRIMER_MOCK_FALLBACK_MODE=never and PRIMER_LLM_PROVIDER_ALLOW_OVERRIDE=0.
PRIMER_MOCK_FALLBACK_MODE=
PRIMER_ALLOW_MOCK_FALLBACK=
PRIMER_JOB_TIMEOUT_MS=
PRIMER_PIPELINE_VERSION=
PRIMER_DISABLE_RESULT_CACHE=
PRIMER_LLM_MODEL=
PRIMER_LLM_PROVIDER_DEFAULT=
PRIMER_LLM_PROVIDER_ALLOW_OVERRIDE=
PRIMER_USER_AGENT=

# --- Market data (live index strip) ---
# Preferred source for /api/market/indices; Yahoo is the keyless fallback.
FINNHUB_API_KEY=

# --- LLM providers ---
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
RELEASE_NOTES_TRANSLATION_MODEL=

# --- Error reporting ---
# Recommended in staging/prod, optional in local.
ERROR_REPORT_WEBHOOK_URL=

# --- Email ---
EMAIL_PROVIDER=
RESEND_API_KEY=
SYSTEM_FROM_EMAIL=
NOTIFICATION_EMAIL=
WEEKLY_EMAIL_FROM=

# --- Reddit (sentiment ingestion) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- SEC filings ---
SEC_USER_AGENT=

# --- Broker / Tink integration ---
BROKER_TOKEN_ENCRYPTION_KEY=
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_AUTH_BASE_URL=
TINK_API_BASE_URL=
TINK_REDIRECT_URI=
TINK_SCOPE=
TINK_LINK_PRODUCTS=
TINK_MARKET=
TINK_ALLOW_MOCK_ACCOUNTS=
TINK_USERNAME=
TINK_USERNAME_PASSWORD=

# --- Jobs / retention ---
JOB_ARTIFACT_RETENTION_DAYS=
JOB_IDEMPOTENCY_WINDOW_HOURS=
JOB_RECOVERY_REQUEUE_ALL_RUNNING=
JOB_RECOVERY_RUNNING_STALE_MS=
JOB_RETENTION_ALERT_THRESHOLD_MS=
JOB_RETENTION_DAYS=

# --- Funnel analytics ---
# Days of funnel events kept before the cleanup sweep deletes them (default 180).
# The number here is stated to users in app/lib/legal/retention.ts; changing it
# changes a published retention period, so change the wording with it.
ANALYTICS_RETENTION_DAYS=

# --- Feature request flags ---
COMMENTS_REQUIRE_LOGIN=
VOTES_REQUIRE_LOGIN=

# --- Admin ---
ADMIN_ALLOWLIST_EMAILS=

# --- Cron ---
WEEKLY_UPDATES_CRON_SECRET=

# --- Consent-gated tags -------------------------------------------------------
# Leave blank to load nothing. A tag needs BOTH an id here and the visitor's
# consent before it is injected (app/components/consent-tags.tsx), so a blank
# value is a hard off switch and is the right setting for staging.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Currency portfolio totals are shown in (decision D5). Blank or malformed
# falls back to SEK. Not a per-user setting.
PORTFOLIO_DISPLAY_CURRENCY=

# How often the worker looks for holders with no portfolio snapshot for today
# (default 6h, minimum 1 minute). Extra sweeps only fill gaps — the first
# capture of each date is the one that is kept — so this is a recovery cadence
# after a restart or a feed outage, not a sampling rate.
PORTFOLIO_SNAPSHOT_SWEEP_INTERVAL_MS=

# never | offline | always. Controls whether a hash-derived placeholder price may
# stand in when both Yahoo and Finnhub fail. Production defaults to `never` even
# if unset, and check:delivery:strict refuses to boot otherwise.
MARKET_MOCK_FALLBACK_MODE=

# Interpreter for the market quote bridge (python/src/market/fetcher.py, needs
# yfinance). Falls back to QUANT_PYTHON_BIN when blank — set this only to run
# the bridge from a separate, lighter venv without the quant stack. With neither
# set the bridge is skipped entirely and the live Yahoo/Finnhub tiers answer.
MARKET_PYTHON_BIN=

# How often the worker refreshes the shared quote cache (default 5 min, minimum
# 1 minute). Each run spawns an interpreter, so the floor is there to stop a
# misconfigured value turning the sweep into a spawn loop.
MARKET_QUOTE_SWEEP_INTERVAL_MS=

# How stale a cached quote may be before the provider chain stops trusting it
# and falls through to a live fetch (default 30 min, minimum 1 minute). Keep it
# several times the sweep interval: the readings are real observations, so one
# failed sweep should not blank the board.
MARKET_QUOTE_MAX_AGE_MS=

# --- Maintenance scripts (not used by the app runtime) ---
# Supabase Management API personal access token, used by scripts/apply-00*.mjs
# to apply migrations to the hosted project. Not needed to run the app.
SUPABASE_ACCESS_TOKEN=
# Only read by scripts/marketstack-omxs30-test.py, an ad-hoc OMXS30 feed probe.
# The app itself uses FINNHUB_API_KEY with a keyless Yahoo fallback.
MARKETSTACK_API_KEY=
